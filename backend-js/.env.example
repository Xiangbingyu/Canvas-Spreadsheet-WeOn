# 推荐架构：Redis Gate + Apply&Store(MySQL)
# 如需单机极简模式，可把下方 redis/mysql 相关驱动改回 memory，并关闭 worker。

# HTTP 服务端口（默认 3000）
PORT=3000

# 节点环境
NODE_ENV=development

# store 驱动：memory | mysql
STORE_DRIVER=mysql

# HTTP / WS 配置
HTTP_JSON_LIMIT=1mb
DOCS_HTTP_JSON_LIMIT=20mb
HTTP_REQUEST_TIMEOUT_MS=120000
WS_MAX_PAYLOAD_BYTES=20971520

# 审计与协同配置
AUDIT_ENABLED=true
AUDIT_MAX_ENTRIES=1000
HISTORY_LIMIT=20
USER_OP_STACK_LIMIT=100
USER_OP_STATE_TTL_MS=1800000
ENABLE_IDEMPOTENCY=true

# 缓存驱动：memory | redis
CACHE_DRIVER=redis
CACHE_KEY_PREFIX=collab
DOC_SNAPSHOT_CACHE_TTL_MS=300000
DOC_META_CACHE_TTL_MS=600000
USER_DOCS_LIST_CACHE_TTL_MS=60000
CACHE_MEMORY_MAX_ENTRIES=1000

# MySQL（二期接入后使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_DATABASE=canvas_spreadsheet
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_CONNECTION_LIMIT=10
MYSQL_CHARSET=utf8mb4
DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3310/canvas_spreadsheet

# Redis（二期接入后使用）
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_URL=redis://127.0.0.1:6381
REDIS_USERNAME=
REDIS_PASSWORD=

# 运行态驱动：memory | redis
RUNTIME_STATE_DRIVER=redis

# 协同广播驱动：memory | redis
COLLAB_BROADCAST_DRIVER=redis
COLLAB_BROADCAST_CHANNEL=collab.doc.events

# 幂等键驱动：memory | redis
IDEMPOTENCY_DRIVER=redis
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_PROCESSING_WAIT_TIMEOUT_MS=2000
IDEMPOTENCY_PROCESSING_POLL_INTERVAL_MS=50

# 文档写锁驱动：memory | redis
DOC_LOCK_DRIVER=redis
DOC_LOCK_TTL_MS=8000
DOC_LOCK_WAIT_TIMEOUT_MS=3000
DOC_LOCK_RETRY_INTERVAL_MS=50

# 多实例时建议为每个实例设置唯一 SERVER_ID
SERVER_ID=server-a

# 实时态驱动：memory | redis
REALTIME_STATE_DRIVER=redis
REALTIME_KEY_PREFIX=collab:rt
REALTIME_STATE_TTL_MS=0

# Op Stream 驱动：memory | redis
OP_STREAM_DRIVER=redis
STREAM_CONSUMER_GROUP=apply-store
STREAM_BATCH_SIZE=64
STREAM_RETAIN_COUNT=500

# Worker 配置
PERSIST_WORKER_ENABLED=true
SNAPSHOT_CHECKPOINT_OP_INTERVAL=200
SNAPSHOT_CHECKPOINT_TIME_WINDOW_MS=30000
